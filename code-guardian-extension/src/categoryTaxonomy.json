{
  "version": "1.0.0",
  "description": "Canonical vulnerability category taxonomy. Shared by the extension (categoryTaxonomy.ts) and the evaluation harness (evaluation/category-taxonomy.js). Pattern order matters: more specific patterns must precede general ones.",
  "categories": [
    "sql-injection",
    "nosql-injection",
    "xss",
    "command-injection",
    "code-injection",
    "path-traversal",
    "ssrf",
    "xxe",
    "ldap-injection",
    "header-injection",
    "deserialization",
    "weak-crypto",
    "weak-encryption",
    "hardcoded-credential",
    "auth-bypass",
    "improper-auth",
    "prototype-pollution",
    "race-condition",
    "redos",
    "input-validation",
    "information-exposure",
    "crypto-verification",
    "other"
  ],
  "patterns": [
    { "regex": "(nosql|mongodb|mongo\\s*injection|cwe-943)", "category": "nosql-injection" },
    { "regex": "(sql\\s*injection|sqli|cwe-89)", "category": "sql-injection" },
    { "regex": "(xss|cross[\\s-]*site[\\s-]*scripting|cwe-79|innerhtml|document\\.write)", "category": "xss" },
    { "regex": "(command[\\s-]*injection|shell[\\s-]*injection|child_process|cwe-78)", "category": "command-injection" },
    { "regex": "(code[\\s-]*injection|eval[\\s-]*injection|template[\\s-]*injection|cwe-94|\\beval\\(|new\\s+function|vm\\.run)", "category": "code-injection" },
    { "regex": "(path[\\s-]*traversal|directory[\\s-]*traversal|zip[\\s-]*slip|non-literal-fs-filename|cwe-22)", "category": "path-traversal" },
    { "regex": "(ssrf|server[\\s-]*side\\s*request\\s*forgery|request\\s*forgery|cwe-918)", "category": "ssrf" },
    { "regex": "(xml\\s*external\\s*entity|xxe|entity\\s*expansion|cwe-611|cwe-776)", "category": "xxe" },
    { "regex": "(ldap[\\s-]*injection|cwe-90)", "category": "ldap-injection" },
    { "regex": "(header[\\s-]*injection|response[\\s-]*splitting|cwe-113)", "category": "header-injection" },
    { "regex": "(deserializ|unsafe\\s*deserialization|insecure\\s*deserialization|cwe-502)", "category": "deserialization" },
    { "regex": "(weak\\s*hashing|weak\\s*hash\\s*algorithm|weak\\s*cipher|weak\\s*random|weak\\s*(crypto|cryptography)|broken\\s*crypto|insecure\\s*random|md5|sha1|\\bdes\\b|cwe-327|cwe-328|cwe-338)", "category": "weak-crypto" },
    { "regex": "(weak\\s*encryption|insufficient\\s*key|cwe-326)", "category": "weak-encryption" },
    { "regex": "(hardcoded\\s*credential|hardcoded\\s*secret|embedded\\s*secret|api\\s*key|cwe-798)", "category": "hardcoded-credential" },
    { "regex": "(authentication\\s*bypass|auth[\\s-]*bypass|jwt.+(none|verify)|timing\\s*attack|cwe-287)", "category": "auth-bypass" },
    { "regex": "(improper\\s*authentication|weak\\s*authentication|missing\\s*authentication)", "category": "improper-auth" },
    { "regex": "(prototype[\\s-]*pollution|object[\\s-]*injection|__proto__|cwe-1321)", "category": "prototype-pollution" },
    { "regex": "(race\\s*condition|toctou|cwe-362)", "category": "race-condition" },
    { "regex": "(regex|re?dos|catastrophic\\s*backtracking|cwe-1333)", "category": "redos" },
    { "regex": "(role\\s*escalation|privilege\\s*escalation|input\\s*validation|validation\\s*bypass|unsanitized\\s*input|cwe-20)", "category": "input-validation" },
    { "regex": "(information\\s*exposure|sensitive\\s*data|data\\s*leak|cwe-200|cwe-532)", "category": "information-exposure" },
    { "regex": "(crypto\\s*verification|signature\\s*verification|timing\\s*safe)", "category": "crypto-verification" }
  ]
}
