<mxfile host="Electron">
  <diagram name="C4 Context">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Privacy boundary -->
        <mxCell id="boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;dashed=1;dashPattern=8 8;" value="" vertex="1">
          <mxGeometry x="80" y="180" width="1140" height="320" as="geometry" />
        </mxCell>
        <mxCell id="boundary-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;fontColor=#666666;" value="Privacy boundary (localhost)" vertex="1">
          <mxGeometry x="90" y="155" width="320" height="20" as="geometry" />
        </mxCell>

        <!-- Developer (outside boundary, top) -->
        <mxCell id="developer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;fontSize=13;" value="Developer&#xa;(JS/TS, VS Code)" vertex="1">
          <mxGeometry x="560" y="40" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- INTERNAL: VS Code IDE (left) -->
        <mxCell id="vscode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;fontSize=13;" value="VS Code IDE&#xa;(editor, diagnostics)" vertex="1">
          <mxGeometry x="120" y="295" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- INTERNAL: Code Guardian (centre, the system) -->
        <mxCell id="codeguardian" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" value="Code Guardian&#xa;(VS Code extension + local backend)" vertex="1">
          <mxGeometry x="490" y="280" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- INTERNAL: Ollama LLM Runtime (right) -->
        <mxCell id="ollama" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;fontSize=13;" value="Ollama LLM Runtime&#xa;(localhost:11434)" vertex="1">
          <mxGeometry x="990" y="295" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- INTERNAL: Vector Database (cylinder, below center) -->
        <mxCell id="vectordb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Vector Database&#xa;(local HNSW)" vertex="1">
          <mxGeometry x="570" y="420" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- EXTERNAL: CVE/NVD APIs (outside boundary, bottom right, dashed) -->
        <mxCell id="cve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;dashed=1;dashPattern=6 6;fontSize=13;" value="CVE/NVD APIs&#xa;(public metadata, optional)" vertex="1">
          <mxGeometry x="990" y="560" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- EDGES -->

        <!-- Developer -> Code Guardian (vertical, from above) -->
        <mxCell id="e1" parent="1" edge="1" source="developer" target="codeguardian" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1-label" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Writes code,&#xa;applies fixes" vertex="1">
          <mxGeometry x="660" y="180" width="100" height="30" as="geometry" />
        </mxCell>

        <!-- VS Code IDE <-> Code Guardian -->
        <mxCell id="e2" parent="1" edge="1" source="vscode" target="codeguardian" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2-label" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Document events,&#xa;diagnostics" vertex="1">
          <mxGeometry x="305" y="320" width="120" height="30" as="geometry" />
        </mxCell>

        <!-- Code Guardian <-> Ollama -->
        <mxCell id="e3" parent="1" edge="1" source="codeguardian" target="ollama" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3-label" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Prompts /&#xa;JSON findings" vertex="1">
          <mxGeometry x="820" y="320" width="120" height="30" as="geometry" />
        </mxCell>

        <!-- Code Guardian -> Vector DB -->
        <mxCell id="e4" parent="1" edge="1" source="codeguardian" target="vectordb" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4-label" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="RAG&#xa;query" vertex="1">
          <mxGeometry x="660" y="395" width="60" height="30" as="geometry" />
        </mxCell>

        <!-- Code Guardian -> CVE/NVD (dashed, optional, leaves boundary) -->
        <mxCell id="e5" parent="1" edge="1" source="codeguardian" target="cve" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#666666;dashed=1;dashPattern=6 6;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5-label" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" value="Optional metadata&#xa;refresh (no code sent)" vertex="1">
          <mxGeometry x="930" y="500" width="160" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
