<mxfile host="Electron">
  <diagram name="Privacy Boundary">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Privacy boundary -->
        <mxCell id="boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;dashed=1;dashPattern=8 8;" value="" vertex="1">
          <mxGeometry x="80" y="120" width="1140" height="340" as="geometry" />
        </mxCell>
        <mxCell id="boundary-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;fontColor=#666666;" value="Privacy boundary (developer machine, localhost)" vertex="1">
          <mxGeometry x="90" y="95" width="400" height="20" as="geometry" />
        </mxCell>

        <!-- Developer (inside, left) -->
        <mxCell id="developer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;fontSize=13;" value="Developer" vertex="1">
          <mxGeometry x="120" y="180" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- VS Code Extension (inside, centre top) -->
        <mxCell id="extension" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=13;" value="VS Code Extension&#xa;(Code Guardian)" vertex="1">
          <mxGeometry x="350" y="170" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Ollama Runtime (inside, right top) -->
        <mxCell id="ollama" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=13;" value="Ollama LLM Runtime&#xa;(localhost:11434)" vertex="1">
          <mxGeometry x="700" y="170" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Local LLM models (inside, far right) -->
        <mxCell id="models" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Local LLM models&#xa;(qwen3, gemma3, ...)" vertex="1">
          <mxGeometry x="1010" y="170" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Source code (inside, lower left) -->
        <mxCell id="source" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Source code&#xa;(workspace files)" vertex="1">
          <mxGeometry x="140" y="350" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Vector store (inside, lower centre) -->
        <mxCell id="vectordb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="HNSW vector store&#xa;(RAG index)" vertex="1">
          <mxGeometry x="380" y="350" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Result + metadata caches (inside, lower right) -->
        <mxCell id="caches" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Result &amp; metadata&#xa;caches" vertex="1">
          <mxGeometry x="620" y="350" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Public Vulnerability APIs (outside, bottom right, dashed) -->
        <mxCell id="cve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;dashed=1;dashPattern=6 6;fontSize=13;" value="Public Vulnerability APIs&#xa;(NVD, OWASP, CWE)" vertex="1">
          <mxGeometry x="900" y="530" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- EDGES -->

        <!-- Developer ↔ Extension -->
        <mxCell id="e1" parent="1" edge="1" source="developer" target="extension" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="edits code" vertex="1">
          <mxGeometry x="265" y="195" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- Extension ↔ Ollama -->
        <mxCell id="e2" parent="1" edge="1" source="extension" target="ollama" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="prompts /&#xa;findings" vertex="1">
          <mxGeometry x="585" y="195" width="100" height="30" as="geometry" />
        </mxCell>

        <!-- Ollama → Local LLM models -->
        <mxCell id="e3" parent="1" edge="1" source="ollama" target="models" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;strokeColor=#666666;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Extension → Source code -->
        <mxCell id="e4" parent="1" edge="1" source="extension" target="source" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#FFFFFF;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Extension → Vector store -->
        <mxCell id="e5" parent="1" edge="1" source="extension" target="vectordb" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#666666;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Extension → Caches -->
        <mxCell id="e6" parent="1" edge="1" source="extension" target="caches" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#666666;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Extension → Public APIs (dashed, optional, leaves boundary) -->
        <mxCell id="e7" parent="1" edge="1" source="extension" target="cve" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#666666;dashed=1;dashPattern=6 6;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1010" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" value="optional metadata refresh&#xa;(no source code transmitted)" vertex="1">
          <mxGeometry x="900" y="475" width="200" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
