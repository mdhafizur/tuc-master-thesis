<mxfile host="app.diagrams.net">
  <diagram name="Privacy Boundary">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Code Guardian — Privacy Boundary" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="164" y="15" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Privacy Boundary Box -->
        <mxCell id="privacy-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;dashed=1;dashPattern=8 8;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="50" y="55" width="720" height="310" as="geometry" />
        </mxCell>
        <mxCell id="privacy-label" value="DEVELOPER MACHINE  —  LOCAL PRIVACY BOUNDARY" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#52793e;" vertex="1" parent="1">
          <mxGeometry x="150" y="60" width="520" height="22" as="geometry" />
        </mxCell>

        <!-- === ROW 1: Developer -> Extension -> Ollama === -->

        <mxCell id="developer" value="" style="shape=mxgraph.basic.smiley;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="105" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dev-label" value="Developer" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="65" y="145" width="70" height="18" as="geometry" />
        </mxCell>

        <mxCell id="vscode" value="VS Code Extension&#xa;(Code Guardian)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="170" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ollama" value="Ollama&#xa;(localhost:11434)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="160" height="55" as="geometry" />
        </mxCell>

        <mxCell id="dev-ext" value="Edits code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" edge="1" parent="1" source="developer" target="vscode">
