        <mxCell id="ext-ollama" value="3. Prompt (code + RAG context)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="vscode" target="ollama">
          <mxGeometry relative="1" as="geometry" />
