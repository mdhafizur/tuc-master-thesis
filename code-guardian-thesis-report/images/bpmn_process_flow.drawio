<mxfile host="Electron">
  <diagram name="BPMN Process Flow">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- POOL -->
        <mxCell id="pool" parent="1" style="shape=swimlane;startSize=20;horizontal=0;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" value="Code Guardian Analysis" vertex="1">
          <mxGeometry x="40" y="80" width="1620" height="500" as="geometry" />
        </mxCell>

        <!-- LANE: Developer -->
        <mxCell id="lane-dev" parent="pool" style="shape=swimlane;horizontal=0;startSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;" value="Developer" vertex="1">
          <mxGeometry x="20" y="0" width="1600" height="140" as="geometry" />
        </mxCell>

        <!-- LANE: Code Guardian System -->
        <mxCell id="lane-sys" parent="pool" style="shape=swimlane;horizontal=0;startSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;" value="Code Guardian System" vertex="1">
          <mxGeometry x="20" y="140" width="1600" height="360" as="geometry" />
        </mxCell>

        <!-- DEVELOPER LANE NODES -->
        <!-- Start event (thin circle) -->
        <mxCell id="ev-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry x="100" y="170" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ev-start-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Edit code" vertex="1">
          <mxGeometry x="80" y="215" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- User task: Edit code -->
        <mxCell id="t-edit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;" value="&#x1F464;  Type / save&#xa;source code" vertex="1">
          <mxGeometry x="200" y="160" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- User task: Review diagnostics -->
        <mxCell id="t-review" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;" value="&#x1F464;  Review findings,&#xa;apply quick fix" vertex="1">
          <mxGeometry x="1380" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- End event (thick circle) -->
        <mxCell id="ev-end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3.5;" value="" vertex="1">
          <mxGeometry x="1580" y="170" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ev-end-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Done" vertex="1">
          <mxGeometry x="1560" y="215" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- SYSTEM LANE NODES -->

        <!-- Receive message event (thin circle with envelope) -->
        <mxCell id="ev-recv" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;" value="&#x2709;" vertex="1">
          <mxGeometry x="200" y="290" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ev-recv-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Document&#xa;change" vertex="1">
          <mxGeometry x="180" y="335" width="80" height="30" as="geometry" />
        </mxCell>

        <!-- Timer intermediate event (clock face) -->
        <mxCell id="ev-timer" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;" value="&#x29D6;" vertex="1">
          <mxGeometry x="290" y="290" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ev-timer-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Debounce&#xa;800 ms" vertex="1">
          <mxGeometry x="270" y="335" width="80" height="30" as="geometry" />
        </mxCell>

        <!-- Script task: Extract function scope -->
        <mxCell id="t-extract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;" value="&#x1F4C4;  Extract function&#xa;scope" vertex="1">
          <mxGeometry x="380" y="280" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- XOR Gateway: Cache hit? -->
        <mxCell id="g-cache" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;" value="&#xD7;" vertex="1">
          <mxGeometry x="570" y="290" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g-cache-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Cache hit?" vertex="1">
          <mxGeometry x="550" y="335" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- XOR Gateway: RAG enabled? -->
        <mxCell id="g-rag" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;" value="&#xD7;" vertex="1">
          <mxGeometry x="690" y="290" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g-rag-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="RAG enabled?" vertex="1">
          <mxGeometry x="660" y="335" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- Service task: Vector search (RAG branch) -->
        <mxCell id="t-rag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;" value="&#x2699;  Vector search&#xa;(top-k)" vertex="1">
          <mxGeometry x="780" y="400" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Service task: LLM Stage 1 inference -->
        <mxCell id="t-llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;" value="&#x2699;  LLM Stage 1&#xa;inference" vertex="1">
          <mxGeometry x="970" y="280" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Script task: Parse JSON & cache -->
        <mxCell id="t-parse" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;" value="&#x1F4C4;  Parse JSON,&#xa;cache result" vertex="1">
          <mxGeometry x="1160" y="280" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Service task: Render diagnostics -->
        <mxCell id="t-render" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;" value="&#x2699;  Render IDE&#xa;diagnostics" vertex="1">
          <mxGeometry x="1350" y="280" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- End event (thick circle) for system lane -->
        <mxCell id="ev-end-sys" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3.5;" value="" vertex="1">
          <mxGeometry x="1530" y="290" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- SEQUENCE FLOWS (solid, within lanes) -->
        <mxCell id="sf-start" parent="1" edge="1" source="ev-start" target="t-edit" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-recv-timer" parent="1" edge="1" source="ev-recv" target="ev-timer" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-timer-extract" parent="1" edge="1" source="ev-timer" target="t-extract" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-extract-cache" parent="1" edge="1" source="t-extract" target="g-cache" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-cache-rag" parent="1" edge="1" source="g-cache" target="g-rag" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;labelBackgroundColor=#FFFFFF;" value="miss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cache HIT branch: gateway top → over → render -->
        <mxCell id="sf-cache-hit" parent="1" edge="1" source="g-cache" target="t-render" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#FFFFFF;" value="hit">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="590" y="245" />
              <mxPoint x="1420" y="245" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- RAG YES branch: down to vector search → up to LLM -->
        <mxCell id="sf-rag-yes" parent="1" edge="1" source="g-rag" target="t-rag" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0;entryY=0.5;fontSize=11;labelBackgroundColor=#FFFFFF;" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-rag-llm" parent="1" edge="1" source="t-rag" target="t-llm" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RAG NO branch: straight to LLM -->
        <mxCell id="sf-rag-no" parent="1" edge="1" source="g-rag" target="t-llm" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;labelBackgroundColor=#FFFFFF;" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-llm-parse" parent="1" edge="1" source="t-llm" target="t-parse" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-parse-render" parent="1" edge="1" source="t-parse" target="t-render" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sf-render-end" parent="1" edge="1" source="t-render" target="ev-end-sys" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MESSAGE FLOWS (dashed, between lanes) -->
        <!-- Edit code → Document change (down) -->
        <mxCell id="mf-edit-recv" parent="1" edge="1" source="t-edit" target="ev-recv" style="endArrow=open;startArrow=oval;startFill=0;html=1;strokeWidth=1;strokeColor=#000000;dashed=1;dashPattern=6 4;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#FFFFFF;" value="onChange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Render diagnostics → Review (up) -->
        <mxCell id="mf-render-review" parent="1" edge="1" source="t-render" target="t-review" style="endArrow=open;startArrow=oval;startFill=0;html=1;strokeWidth=1;strokeColor=#000000;dashed=1;dashPattern=6 4;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=11;labelBackgroundColor=#FFFFFF;" value="diagnostics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Review → End (sequence in dev lane) -->
        <mxCell id="sf-review-end" parent="1" edge="1" source="t-review" target="ev-end" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
